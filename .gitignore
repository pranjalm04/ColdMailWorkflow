.venv/
__pycache__/
*.pyc

.env

# Keep the data/, credentials/, and output/ folders tracked (so the repo is
# self-documenting about what's required) but ignore everything inside them —
# they hold PII, secrets, and generated state that must never be committed.
# The .gitkeep placeholders are the only tracked files in each.
data/*
!data/.gitkeep

credentials/*
!credentials/.gitkeep

output/*
!output/.gitkeep

# Personal resume binary — keep the folder, ignore its contents
resume/*
!resume/.gitkeep

.DS_Store
.idea/
.vscode/
.claude/
